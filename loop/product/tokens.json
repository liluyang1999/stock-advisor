  "state_colors_derivation": {
    "hover": "Tk ACCENT_HOVER #214d76 — the baseline's primary-button hover fill",
    "pressed": "Tk ACCENT_PRESSED #102d49 — the baseline's primary-button pressed fill",
    "disabled": "Tk MUTED_LIGHT #89939d; intentionally not contrast-tested because WCAG 2.1 exempts disabled-control text/graphics from the contrast requirement",
    "selected_row": "Tk SELECTION_BG #dbe7ee — Treeview selected-row fill; ink is drawn on top",
    "gridline": "Tk BORDER_SOFT #e7e3da — 1px dividers between cards and rows; a divider, not text",
    "focus_ring": "a distinct, brighter blue (not the base interactive hex) so a focused primary button's own ring never blends into its own fill"
  },
  "contrast": {
    "methodology": "WCAG 2.x relative luminance and contrast ratio: per-channel sRGB c'=c/255 linearized as c/12.92 when c'<=0.03928 else ((c'+0.055)/1.055)^2.4; L=0.2126R+0.7152G+0.0722B; ratio=(L_lighter+0.05)/(L_darker+0.05). Every foreground is measured against each surface it is actually drawn on (page/card/control/table_header, plus the row-tag fills, the command band and the selected row). Recomputed from this file's own values, not carried over.",
