{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"config.schema.json",
  "type":"object",
  "required":["schema_version","project","target_stack","ui_tokens","network_policy","commands","quality_policy","paths"],
  "properties":{
    "schema_version":{"type":"string"},
    "project":{"type":"object","required":["name","timezone","text_encoding"]},
    "target_stack":{"type":"object","required":["python","gui","runtime_font"]},
    "ui_tokens":{"type":"object","required":["font_families","font_points","spacing_dip"]},
    "network_policy":{"type":"object","required":["target_transport","migration_transport","operation_deadlines_seconds","max_attempts","fabricated_fallbacks_allowed"]},
    "commands":{"type":"object"},
    "quality_policy":{"type":"object"},
    "paths":{"type":"object"}
  },
  "additionalProperties":true
}
