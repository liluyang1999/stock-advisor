{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"loop.schema.json",
  "type":"object",
  "required":["schema_version","id","status","trigger","goal","cycle","memory","terminal_states","stop_rules","human_gates"],
  "properties":{
    "$schema":{"type":"string"},
    "schema_version":{"type":"string","const":"1.0.0"},
    "id":{"type":"string","minLength":1},
    "name":{"type":"string"},
    "status":{"enum":["initialized","active","paused","complete","superseded"]},
    "trigger":{"type":"object","required":["mode"]},
    "goal":{"type":"object","required":["objective_id","statement","success_requires"]},
    "scope":{"type":"object"},
    "cycle":{"type":"array","minItems":5,"items":{"type":"string"}},
    "roles":{"type":"object"},
    "verification_ladder":{"type":"array","items":{"type":"string"}},
    "memory":{"type":"object"},
    "terminal_states":{"type":"array","minItems":4,"items":{"type":"string"}},
    "stop_rules":{"type":"array","minItems":1,"items":{"type":"string"}},
    "human_gates":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":false
}

