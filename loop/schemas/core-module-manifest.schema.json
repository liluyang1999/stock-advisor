{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"core-module-manifest.schema.json",
  "type":"object",
  "required":["schema_version","source_root","package_name","forbidden_import_roots","forbidden_internal_modules","modules"],
  "properties":{
    "schema_version":{"type":"string"},
    "source_root":{"type":"string","minLength":1},
    "package_name":{"type":"string","minLength":1},
    "forbidden_import_roots":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "forbidden_internal_modules":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "modules":{
      "type":"array","minItems":1,"uniqueItems":true,
      "items":{
        "type":"object","required":["path","layer"],
        "properties":{"path":{"type":"string","pattern":"^[A-Za-z0-9_/-]+\\.py$"},"layer":{"type":"string","minLength":1}},
        "additionalProperties":false
      }
    }
  },
  "additionalProperties":true
}
